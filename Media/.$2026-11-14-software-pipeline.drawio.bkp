ready&quot; reply" style="rounded=0;whiteSpace=wrap;html=1;arcSize=8;absoluteArcSize=1;fillColor=#FFFDF5;strokeColor=#E6C36A;strokeWidth=1.5;fontSize=20;fontColor=#5A4A1A;fontFamily=Source Sans Pro;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DSource%2BSans%2BPro;" vertex="1" parent="1"><mxGeometry x="930" y="2346" width="190" height="44" as="geometry"/></mxCell><mxCell id="gt20_a" value="'h'" style="rounded=0;whiteSpace=wrap;html=1;arcSize=8;absoluteArcSize=1;fillColor=#FFFDF5;strokeColor=#E6C36A;strokeWidth=1.5;fontSize=20;fontColor=#5A4A1A;fontFamily=DejaVu Sans Mono;" vertex="1" parent="1"><mxGeometry x="380" y="2390" width="80" height="44" as="geometry"/></mxCell><mxCell id="gt21_a" value="actor not IDLE or HOMING" style="rounded=0;whiteSpace=wrap;html=1;arcSize=8;absoluteArcSize=1;fillColor=#FFFDF5;strokeColor=#E6C36A;strokeWidth=1.5;fontSize=20;fontColor=#5A4A1A;fontFamily=Source Sans Pro;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DSource%2BSans%2BPro;" vertex="1" parent="1"><mxGeometry x="460" y="2390" width="300" height="44" as="geometry"/></mxCell><mxCell id="gt22_a" value="heartGesture" style="rounded=0;whiteSpace=wrap;html=1;arcSize=8;absoluteArcSize=1;fillColor=#FFFDF5;strokeColor=#E6C36A;strokeWidth=1.5;fontSize=20;fontColor=#5A4A1A;fontFamily=DejaVu Sans Mono;" vertex="1" parent="1"><mxGeometry x="760" y="2390" width="170" height="44" as="geometry"/></mxCell><mxCell id="gt23_a" value="ignored" style="rounded=0;whiteSpace=wrap;html=1;arcSize=8;absoluteArcSize=1;fillColor=#FFFDF5;strokeColor=#E6C36A;strokeWidth=1.5;fontSize=20;fontColor=#5A4A1A;fontFamily=Source Sans Pro;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DSource%2BSans%2BPro;" vertex="1" parent="1"><mxGeometry x="930" y="2390" width="190" height="44" as="geometry"/></mxCell><mxCell id="sm_a" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;absoluteArcSize=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=3;fontSize=36;fontColor=#222222;fontFamily=Source Sans Pro;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DSource%2BSans%2BPro;" vertex="1" parent="1"><mxGeometry x="1190" y="2240" width="340" height="262" as="geometry"/></mxCell><mxCell id="title" value="&lt;span style=&quot;font-size:32px;color:#111111;letter-spacing:0px;&quot;&gt;SOFTWARE PIPELINE&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;spacing=0;fontFamily=Source Sans Pro;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DSource%2BSans%2BPro;" vertex="1" parent="1"><mxGeometry x="0" y="22" width="1570" height="46" as="geometry"/></mxCell><mxCell id="lane_s_t" value="&lt;span style=&quot;font-size:30px;color:#333333;letter-spacing:3px;font-weight:bold;&quot;&gt;LANDMARKS&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:26px;color:#888888;letter-spacing:0px;&quot;&gt;landmarks_sender.py&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Source Sans Pro;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DSource%2BSans%2BPro;" vertex="1" parent="1"><mxGeometry x="48" y="371.0" width="400" height="84" as="geometry"/></mxCell><mxCell id="k_norm_t" value="&lt;span style=&quot;font-size:28px;color:#5A4A1A;letter-spacing:0px;font-weight:bold;&quot;&gt;normalise(): position and size removed&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:24px;color:#5A4A1A;letter-spacing:0px;&quot;&gt;wrist becomes the origin: x − x_wrist (same for y, z)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:24px;color:#5A4A1A;letter-spacing:0px;&quot;&gt;ruler = distance wrist → middle-finger base&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:24px;color:#5A4A1A;letter-spacing:0px;&quot;&gt;every value ÷ ruler, so the hand reads the same&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:24px;color:#5A4A1A;letter-spacing:0px;&quot;&gt;anywhere in the frame, near or far from the camera&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Source Sans Pro;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DSource%2BSans%2BPro;" vertex="1" parent="1"><mxGeometry x="844" y="402" width="662" height="172" as="geometry"/></mxCell><mxCell id="k_msg_t" value="&lt;span style=&quot;font-size:28px;color:#5A4A1A;letter-spacing:0px;font-weight:bold;&quot;&gt;No hand found?&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:24px;color:#5A4A1A;letter-spacing:0px;&quot;&gt;63 × 0.0 is sent, so Wekinator always gets 63 inputs&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Source Sans Pro;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DSource%2BSans%2BPro;" vertex="1" parent="1"><mxGeometry x="844" y="624" width="662" height="84" as="geometry"/></mxCell><mxCell id="lbl_c1" value="&lt;span style=&quot;font-size:26px;color:#666666;letter-spacing:0px;&quot;&gt;to Wekinator · /wek/inputs · OSC :6448&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Source Sans Pro;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DSource%2BSans%2BPro;" vertex="1" parent="1"><mxGeometry x="670.0" y="773" width="700" height="36" as="geometry"/></mxCell><mxCell id="wk_gap" value="&lt;span style=&quot;font-size:24px;color:#AAAAAA;letter-spacing:0px;&quot;&gt;Wekinator (see system overview)&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;spacing=0;fontFamily=Source Sans Pro;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DSource%2BSans%2BPro;" vertex="1" parent="1"><mxGeometry x="260.0" y="846" width="600" height="36" as="geometry"/></mxCell><mxCell id="lbl_c2" value="&lt;span style=&quot;font-size:26px;color:#666666;letter-spacing:0px;&quot;&gt;from Wekinator · /wek/outputs · OSC :12000&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Source Sans Pro;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DSource%2BSans%2BPro;" vertex="1" parent="1"><mxGeometry x="670.0" y="903" width="700" height="36" as="geometry"/></mxCell><mxCell id="lane_b_t" value="&lt;span style=&quot;font-size:30px;color:#333333;letter-spacing:3px;font-weight:bold;&quot;&gt;BRIDGE&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:26px;color:#888888;letter-spacing:0px;&quot;&gt;bridge.py&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Source Sans Pro;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DSource%2BSans%2BPro;" vertex="1" parent="1"><mxGeometry x="48" y="1363.0" width="400" height="84" as="geometry"/></mxCell><mxCell id="k_conv_t" value="&lt;span style=&quot;font-size:28px;color:#5A4A1A;letter-spacing:0px;font-weight:bold;&quot;&gt;From Wekinator float to Arduino letter&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Source Sans Pro;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DSource%2BSans%2BPro;" vertex="1" parent="1"><mxGeometry x="844" y="1084" width="662" height="502" as="geometry"/></mxCell><mxCell id="k_rules" value="&lt;span style=&quot;font-size:24px;color:#5A4A1A;letter-spacing:0px;&quot;&gt;round(): Wekinator sends 2.0, the bridge uses 2.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:24px;color:#5A4A1A;letter-spacing:0px;&quot;&gt;Hold: the same class for 3 s (≈ 45 messages at 15/s).&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:24px;color:#5A4A1A;letter-spacing:0px;&quot;&gt;Reset: a new class, or a gap &amp;gt; 0.5 s, restarts the count.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:24px;color:#5A4A1A;letter-spacing:0px;&quot;&gt;Once: one letter per hold, then it waits for a new gesture.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:24px;color:#5A4A1A;letter-spacing:0px;&quot;&gt;Class 1 (none) never sends anything.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Source Sans Pro;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DSource%2BSans%2BPro;" vertex="1" parent="1"><mxGeometry x="855" y="1350" width="650" height="200" as="geometry"/></mxCell><mxCell id="lbl_c3" value="&lt;span style=&quot;font-size:26px;color:#666666;letter-spacing:0px;&quot;&gt;'s' / 'h' to Arduino · USB serial 115200&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Source Sans Pro;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DSource%2BSans%2BPro;" vertex="1" parent="1"><mxGeometry x="670.0" y="1836" width="620" height="70" as="geometry"/></mxCell><mxCell id="lane_ard_t_a" value="&lt;span style=&quot;font-size:30px;color:#333333;letter-spacing:3px;font-weight:bold;&quot;&gt;ARDUINO&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:26px;color:#888888;letter-spacing:0px;&quot;&gt;PuppetScene.ino&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Source Sans Pro;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DSource%2BSans%2BPro;" vertex="1" parent="1"><mxGeometry x="48" y="2208.0" width="400" height="84" as="geometry"/></mxCell><mxCell id="lbl_loop_a" value="&lt;span style=&quot;font-size:22px;color:#666666;letter-spacing:0px;&quot;&gt;loop() repeats as fast as possible · no delay()&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;spacing=0;fontFamily=Source Sans Pro;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DSource%2BSans%2BPro;" vertex="1" parent="1"><mxGeometry x="750" y="1970" width="500" height="34" as="geometry"/></mxCell><mxCell id="k_gate_t_a" value="&lt;span style=&quot;font-size:28px;color:#5A4A1A;letter-spacing:0px;font-weight:bold;&quot;&gt;Serial gate · letter → flag (both actors)&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Source Sans Pro;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DSource%2BSans%2BPro;" vertex="1" parent="1"><mxGeometry x="384" y="2254" width="732" height="242" as="geometry"/></mxCell><mxCell id="k_gate_n_a" value="&lt;span style=&quot;font-size:22px;color:#5A4A1A;letter-spacing:0px;&quot;&gt;A letter never moves a motor: it only raises a flag&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:22px;color:#5A4A1A;letter-spacing:0px;&quot;&gt;that updateActor() reads on its next pass.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Source Sans Pro;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DSource%2BSans%2BPro;" vertex="1" parent="1"><mxGeometry x="380" y="2446" width="740" height="70" as="geometry"/></mxCell><mxCell id="sm_t_a" value="&lt;span style=&quot;font-size:28px;color:#333333;letter-spacing:0px;font-weight:bold;&quot;&gt;State machine&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:22px;color:#888888;letter-spacing:0px;&quot;&gt;updateActor(), per actor&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666;letter-spacing:0px;&quot;&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px;color:#333333;letter-spacing:0px;font-family:DejaVu Sans Mono;&quot;&gt;HOMING, IDLE, MOVE_12,&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px;color:#333333;letter-spacing:0px;font-family:DejaVu Sans Mono;&quot;&gt;MOVE_21, HOLD, DANCE,&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px;color:#333333;letter-spacing:0px;font-family:DejaVu Sans Mono;&quot;&gt;EXIT&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666666;letter-spacing:0px;&quot;&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px;color:#999999;letter-spacing:0px;&quot;&gt;Details: section 2.3&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontFamily=Source Sans Pro;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%